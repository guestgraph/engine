#!/bin/sh
# service-conventions-check — read a service on the Spring stack against SERVICE.md, the list
# of what every guestgraph service has, and say what is missing.
#
#   sh service-conventions/service-conventions-check    exit 1 with one ✗ line per missing item
#
# The check reads files; what the service does with them is its own suite's to prove. It reads
# service-conventions.json for the root, the tag and the schema, and sources.json under the API folder
# for what the served document is generated from. SERVICE_CONVENTIONS_ROOT overrides the
# directory read, which is how the tests run on fixtures.
# Needs sh, awk, sed, grep, find, curl, and shasum or sha256sum.
set -eu

ROOT=${SERVICE_CONVENTIONS_ROOT:-.}
cd "$ROOT"
PIN=service-conventions.json
YAML=src/main/resources/application.yaml
status=0
miss() { echo "✗ service-conventions: $1: $2"; status=1; }

[ -f "$PIN" ] || { echo "✗ service-conventions: pin: no $PIN here" >&2; exit 1; }
pin() { sed -n "s/.*\"$1\" *: *\"\([^\"]*\)\".*/\1/p" "$PIN" | head -1; }
root=$(pin root); tag=$(pin tag); schema=$(pin schema)
[ -n "$root" ] && [ -n "$tag" ] && [ -n "$schema" ] || { echo "✗ service-conventions: pin: $PIN needs \"root\", \"tag\" and \"schema\"" >&2; exit 1; }
rootpath=src/main/java/$(echo "$root" | tr . /)
version=${tag#v}

sha() {
  if command -v sha256sum > /dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
  else shasum -a 256 "$1" | cut -d' ' -f1; fi
}

# parent: pom.xml names the parent at the pinned version by relativePath
parent=$(awk '/<parent>/{p=1} p{print} /<\/parent>/{exit}' pom.xml 2>/dev/null || true)
echo "$parent" | grep -q '<artifactId>service-parent</artifactId>' \
  && echo "$parent" | grep -q "<version>$version</version>" \
  && echo "$parent" | grep -q '<relativePath>service-conventions/pom.xml</relativePath>' \
  || miss parent "pom.xml does not name io.guestgraph:service-parent $version by relativePath service-conventions/pom.xml"

# root: the root package exists and holds every source under io/guestgraph
if [ -d "$rootpath" ]; then
  # The shared runtime, io.guestgraph.service, sits beside the root in every service.
  stray=$(find src/main/java/io/guestgraph -name '*.java' 2>/dev/null | grep -v "^$rootpath/" | grep -v '^src/main/java/io/guestgraph/service/' | head -1 || true)
  [ -z "$stray" ] || miss root "$stray is outside the root package $root"
else
  miss root "$rootpath does not exist; the pin names $root"
fi

# api: endpoints, filters and error answers sit under <root>.api
if [ -d "$rootpath/api" ]; then
  outside=$(grep -rlE '@RestController|@Controller|@ControllerAdvice|extends (OncePerRequestFilter|HttpFilter|GenericFilter)|implements (Filter|HandlerInterceptor)' src/main/java 2>/dev/null | grep -v "^$rootpath/api/" | grep -v '^src/main/java/io/guestgraph/service/' | head -1 || true)
  [ -z "$outside" ] || miss api "$outside is an endpoint or filter outside $root.api"
else
  miss api "$rootpath/api does not exist"
fi

# api-document: one generated openapi.yaml, its sources named beside it, nothing unlisted
API=src/main/resources/api
[ -f "$API/openapi.yaml" ] && head -1 "$API/openapi.yaml" | grep -q '^# GENERATED by service-conventions/regen-api' \
  || miss api-document "$API/openapi.yaml is missing or not generated by service-conventions/regen-api"
if [ -f "$API/sources.json" ]; then
  grep -q '"sources"' "$API/sources.json" && grep -q '"[^"]*"[[:space:]]*[],]' "$API/sources.json" \
    || miss api-document "$API/sources.json names no sources"
  for doc in $(ls "$API"/*.yaml 2>/dev/null); do
    name=$(basename "$doc"); [ "$name" = openapi.yaml ] && continue
    grep -qF "$API/$name" "$API/sources.json" || miss api-document "$name is under $API and $API/sources.json does not name it as a source"
  done
else
  miss api-document "$API/sources.json is missing; the served document is generated from named sources"
fi
grep -rq '"/api-docs"' "$rootpath/api" src/main/java/io/guestgraph/service 2>/dev/null || miss api-document "no class under $root.api or the shared runtime maps /api-docs"

# defaults: the shared settings live once, beneath the service's own; the service names its schema
DEFAULTS=src/main/resources/service-defaults.yaml
if [ -f "$DEFAULTS" ]; then
  grep -Eq "^[[:space:]]*schema:[[:space:]]*$schema[[:space:]]*$" "$YAML" 2>/dev/null || miss defaults "$YAML does not set service.schema to $schema"
  # What is fixed for every service may not be restated; a value a service may set for itself,
  # the request cap, is a default the service overrides above it.
  for key in 'virtual:' 'problemdetails:' 'hikari:' 'default-schema:' 'create-schemas:' 'open-in-view:' 'ddl-auto:' 'lifecycle-management:' 'exposure:'; do
    grep -q "$key" "$YAML" 2>/dev/null && miss defaults "$YAML restates $key, which $DEFAULTS carries" || true
  done
  SHARED=$DEFAULTS
else
  SHARED=$YAML
fi

# health: the actuator exposes health and nothing else
grep -Eq '^[[:space:]]*include:[[:space:]]*health[[:space:]]*$' "$SHARED" 2>/dev/null \
  || miss health "$SHARED does not expose health alone under management.endpoints.web.exposure.include"

# problem-details
awk '/problemdetails:/{p=NR} p && NR==p+1 && /enabled:[[:space:]]*true/{f=1} END{exit !f}' "$SHARED" 2>/dev/null \
  || miss problem-details "$SHARED does not enable spring.mvc.problemdetails"

# request-cap: a property, and a class under api or the shared runtime that reads it
grep -q 'max-request-bytes:' "$SHARED" "$YAML" 2>/dev/null || miss request-cap "neither $SHARED nor $YAML has a max-request-bytes property"
grep -rq 'max-request-bytes' "$rootpath/api" src/main/java/io/guestgraph/service 2>/dev/null || miss request-cap "no class under $root.api or the shared runtime reads max-request-bytes"

# schema: one variable in both places, the service's name as its default
if [ -f "$DEFAULTS" ]; then
  grep -q 'schema: ${DATABASE_SCHEMA:${service.schema}}' "$DEFAULTS" || miss schema "$DEFAULTS does not set hikari.schema from DATABASE_SCHEMA and service.schema"
  grep -q 'default-schema: ${DATABASE_SCHEMA:${service.schema}}' "$DEFAULTS" || miss schema "$DEFAULTS does not set flyway.default-schema from DATABASE_SCHEMA and service.schema"
else
  grep -q "schema: \${DATABASE_SCHEMA:$schema}" "$YAML" 2>/dev/null || miss schema "$YAML does not set hikari.schema to \${DATABASE_SCHEMA:$schema}"
  grep -q "default-schema: \${DATABASE_SCHEMA:$schema}" "$YAML" 2>/dev/null || miss schema "$YAML does not set flyway.default-schema to \${DATABASE_SCHEMA:$schema}"
fi

# diagram
[ -f docs/er-schema.mmd ] && head -1 docs/er-schema.mmd | grep -q '^%% GENERATED by service-conventions/regen-er' \
  || miss diagram "docs/er-schema.mmd is missing or not generated by service-conventions/regen-er"

# local-profile
grep -q 'on-profile: local' "$YAML" 2>/dev/null || [ -f src/main/resources/application-local.yaml ] \
  || miss local-profile "no local profile in $YAML and no application-local.yaml"

# readme
for phrase in 'create role' 'create schema' './mvnw verify' 'service-conventions-check'; do
  grep -qF "$phrase" README.md 2>/dev/null || miss readme "README.md does not carry '$phrase'"
done

# agents: the stack's block after the family's
awk '/<!-- end conventions -->/{c=NR} /<!-- service-conventions · /{s=NR} END{exit !(c && s && s>c)}' AGENTS.md 2>/dev/null \
  || miss agents "AGENTS.md does not carry the service-conventions block after the family's block"

exit $status
