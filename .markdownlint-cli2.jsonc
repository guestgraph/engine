// The family's one Markdown form, as rules. It sits at the repository root under the name
// markdownlint-cli2 and the editor plugins built on it look for, because a form held in CI and
// not in the editor is a form a writer meets only after pushing. conventions-format names this
// file explicitly and an editor finds it without being told; both read these bytes, so a file
// saved in an editor and a file written by `conventions-format fix` come out the same.
//
// The paragraph these rules enforce is the Markdown paragraph of conventions/WRITING.md, and the
// one rule markdownlint does not ship is conventions/markdown-rules.cjs beside them. Edit either
// in robertblust/conventions and never in a member: conventions-sync vendors both and
// conventions-check holds every copy to the release.
//
// Every rule here is one markdownlint can write, so `fix` and a save in the editor settle every
// hit and leave a reader nothing to do by hand. A rule that only reports is a rule that nags,
// and a form that nags is one a writer turns off.
//
// Two rules that would otherwise belong are deliberately absent, each rejected on what it did to
// this family's own text. MD038 strips the spaces inside a code span, and `# ` with its space is
// the H1 prefix REPOSITORIES.md names in a sentence, so its fix would make that sentence wrong,
// in seventy places across the family. MD029 renumbers an ordered list, which is an editorial
// change to prose and rests on a choice between 1/1/1 and 1/2/3 that nobody here has made.
{
  "config": {
    "default": false,

    // Tables, emphasis, list markers and whitespace: the Markdown paragraph of WRITING.md.
    "MD004": { "style": "dash" },
    "MD009": true,
    "MD010": { "code_blocks": false },
    "MD012": true,
    "MD047": true,
    "MD049": { "style": "asterisk" },
    "MD050": { "style": "asterisk" },
    "MD055": { "style": "leading_and_trailing" },
    "MD060": { "style": "compact" },
    "table-delimiter-row": true,

    // A heading, a list, a fence and a table stand clear of the text around them by a blank
    // line, because a list crowded against its lead-in is a list some readers never see as one.
    "MD022": true,
    "MD031": true,
    "MD032": true,
    "MD058": true,

    // The shapes the family already writes, held so they stay that way. Each was measured over
    // every member's Markdown with nothing to fix, so it costs no rewrite anywhere and catches
    // the first file that drifts.
    "MD003": { "style": "atx" },
    "MD005": true,
    "MD007": true,
    "MD011": true,
    "MD018": true,
    "MD019": true,
    "MD020": true,
    "MD021": true,
    "MD023": true,
    "MD027": true,
    "MD030": true,
    "MD035": true,
    "MD037": true,
    "MD039": true,
    "MD048": { "style": "backtick" }
  },
  "customRules": ["./conventions/markdown-rules.cjs"]
}
