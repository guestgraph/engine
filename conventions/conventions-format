#!/bin/sh
# conventions-format — hold a member's Markdown to the one form WRITING.md gives it, whatever
# editor wrote it last. The form is the rule set in
# .markdownlint-cli2.jsonc at the member's root, with the one rule markdownlint does not ship in
# conventions/markdown-rules.cjs, and the tool is markdownlint-cli2 at the version below, the
# same library an editor plugin can bundle, so a file a tool reformatted and a file a person
# wrote come out byte for byte the same. The rules sit at
# the root under that name because it is the name an editor plugin discovers without being told,
# which is how the same form reaches a writer before they push and not only afterwards. What the
# editor is then asked to do with them lives in .vscode/, which every member keeps out of git, so
# nothing here reads it: conventions-sync writes those two files and no check holds a member to
# them.
#
#   sh conventions/conventions-format          check: exit 1 with one line per hit, file:line
#   sh conventions/conventions-format fix      rewrite every hit into the form, in place
#
# Needs sh, find, sort and sed, and Node 22 or later for npx; the tool is fetched by npx on
# first use and cached after. git is used where it is there, to
# leave out what it ignores. The files are every Markdown file but .git, node_modules at any
# depth, what .gitignore names, and the folders under "format-exclude" in conventions.json, or
# under "exclude" where a member names no "format-exclude", so that a member that has not
# decided reads as it did.
# CONVENTIONS_ROOT overrides the directory, which is how the tests point it at a fixture.
set -eu

VERSION=0.23.2
ROOT=${CONVENTIONS_ROOT:-.}
PIN=$ROOT/conventions.json
RULES=.markdownlint-cli2.jsonc

cmd=${1:-check}
case $cmd in check|fix) ;; *) echo "usage: sh conventions/conventions-format [check|fix]" >&2; exit 2 ;; esac

[ -f "$ROOT/$RULES" ] || { echo "✗ conventions: no $RULES under $ROOT — run sync" >&2; exit 1; }
command -v npx > /dev/null 2>&1 || { echo "✗ conventions: the Markdown form needs Node 22 or later, and npx is not on the PATH" >&2; exit 1; }

# The tool is run from the root, so the paths it prints are the paths a member sees.
cd "$ROOT"
ROOT=.
PIN=$ROOT/conventions.json

# The folders not held to the form, one entry per line. "exclude" is the prose check's list, and
# some of what it leaves out is prose that quotes the words it scans for, which is no reason to
# leave its tables unformatted; "format-exclude" is this check's own list, for what is someone
# else's to format, a vendored copy or a fixture. Read as conventions-check reads its list.
excludes=""
if [ -f "$PIN" ]; then
  key=exclude
  if tr -d '\n' < "$PIN" | grep -q '"format-exclude" *:'; then key=format-exclude; fi
  excludes=$(tr -d '\n' < "$PIN" | sed -n "s/.*\"$key\" *: *\[\([^]]*\)\].*/\1/p" | tr ',' '\n' | sed -n 's/^[^"]*"\([^"]*\)".*/\1/p')
fi

set -- "$ROOT" -path "$ROOT/.git" -prune -o -name node_modules -prune -o
oldifs=$IFS
IFS='
'
for e in $excludes; do
  set -- "$@" -path "$ROOT/${e%/}" -prune -o
done
IFS=$oldifs
set -- "$@" -name '*.md' -type f -print

files=$(find "$@" 2> /dev/null | LC_ALL=C sort || true)

# What git ignores is scratch, not the repository's Markdown: a build folder, a tool's working
# directory, a vault's cache. It is absent from the shared job, which checks out tracked files
# only, so without this a local run fails on files the job can never see while the job stays
# green. A file that is merely new is still read, because it is on its way to being committed.
# Where git is missing or this is no repository the walk is unchanged, so a plain directory
# still formats.
# core.quotePath is off because git C-quotes a path with a non-ASCII byte in it — a de-CH file
# name with an umlaut — and a quoted path matches nothing in the list it came from.
if command -v git > /dev/null 2>&1 && git rev-parse --git-dir > /dev/null 2>&1; then
  ignored=$(printf '%s\n' "$files" | git -c core.quotePath=false check-ignore --stdin 2> /dev/null) || ignored=""
  [ -z "$ignored" ] || files=$(printf '%s\n' "$files" | grep -vxF "$ignored" || true)
fi

if [ -z "$files" ]; then
  echo "✗ conventions: no Markdown file was formatted under $ROOT" >&2
  exit 1
fi

# The tool reads its arguments as globs; a leading colon makes each path literal, so a file
# name with brackets or parentheses in it is the file and not a pattern.
set -- --config "$RULES"
while IFS= read -r f; do
  set -- "$@" ":$f"
done <<EOF
$files
EOF

lint() { npx --yes "markdownlint-cli2@$VERSION" "$@" 2>&1; }

# Two fixes on one line are applied one per pass, and a padded table's delimiter row takes two,
# the spacing and the length, so fix runs again while hits remain, three passes at most.
if [ "$cmd" = fix ]; then
  passes=0
  while [ "$passes" -lt 3 ] && ! lint --fix "$@" > /dev/null; do passes=$((passes + 1)); done
fi

markdown=0
if out=$(lint "$@"); then
  if [ "$cmd" = fix ]; then echo "✓ every Markdown file is in the family's form, fixed where it was not"
  else echo "✓ every Markdown file is in the family's form"; fi
else
  markdown=1
  # The tool reports a table once per pipe; a reader wants the line once per rule.
  printf '%s\n' "$out" | sed -n 's/^\(.*\.md:[0-9][0-9]*\)[:0-9]* error \([A-Za-z0-9/-]*\).*/✗ \1: \2/p' | uniq
  if [ "$cmd" = fix ]; then
    echo "✗ conventions: the hits above have no automatic fix; edit them by hand" >&2
  else
    echo "✗ conventions: sh conventions/conventions-format fix rewrites these into the form" >&2
  fi
fi

exit "$markdown"
